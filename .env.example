# Copie para .env (ou defina no painel da hospedagem). Nunca coloque a chave no código ou no Git.
ANTHROPIC_API_KEY=sk-ant-...

# Código que os controladores digitam em Ajustes (opcional agora com autenticação de usuários)
APP_TOKEN=

# Conexão com o banco PostgreSQL (usuário postgres, senha postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cprt_aco

# Opcional
# Modelo preciso: lê as etiquetas e refaz placa/crachá quando o modelo barato errar
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo barato: lê placa e crachá primeiro (padrão claude-haiku-5-5). Use o mesmo valor de ANTHROPIC_MODEL para desligar
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
PORT=3334
RATE_LIMIT_PER_MIN=40
TRUST_PROXY=1
